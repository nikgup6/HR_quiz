# Neon Postgres connection string (Vercel → Storage → Neon adds this automatically)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# 32+ random characters used to sign HR session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# First HR account, created automatically on first request if it does not exist.
HR_ADMIN_EMAIL=
HR_ADMIN_PASSWORD=
HR_ADMIN_NAME=HR Admin
